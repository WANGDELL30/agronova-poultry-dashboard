PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# mock: telemetry and vision both use deterministic mock data (no backend needed).
# api:  vision uses the real API + inference service; the telemetry overview shows its
#       "unavailable" state because backend telemetry belongs to a later phase.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_MOCK_SCENARIO=normal
NEXT_PUBLIC_MOCK_INTERVAL_MS=5000
