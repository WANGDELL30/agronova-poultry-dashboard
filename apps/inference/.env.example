# Copy to apps/inference/.env and start with:
#   python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --env-file .env
# (uvicorn[standard] includes python-dotenv, which --env-file needs.) Never commit the real .env.

# mock = deterministic, no GPU, does not read the image. real = Qwen3-VL + LoRA on an NVIDIA GPU.
INFERENCE_MODE=mock
# Shared secret with the API (X-API-Key). Required in real mode (the service refuses to start
# without it); optional in mock mode. Same value as INFERENCE_API_KEY in apps/api/.env.
INFERENCE_API_KEY=
# Real mode only, optional: the default adapter repo is public. Set it only for a private adapter
# repo. Never commit a real token.
HF_TOKEN=
HF_ADAPTER_REPO=Arga23/chickenstress-vlm-lora
HF_BASE_MODEL=Qwen/Qwen3-VL-4B-Instruct
# Commits that passed the T4 parity check (S10/P7). Hub ids load at these revisions; for a local
# folder they are only reported (response field `model`). Unset = the default, empty = no pin.
INFERENCE_BASE_REVISION=ebb281ec70b05090aa6165b016eac8ec08e71b17
INFERENCE_ADAPTER_REVISION=51b653173b0ef8945508bd10f2ebdcaebfd3e441
# Must equal VISION_MAX_IMAGE_BYTES in apps/api/.env (AUDIT H8).
VISION_MAX_IMAGE_BYTES=8388608
# Image limits applied before the quality gate (AUDIT R2).
INFERENCE_MAX_IMAGE_PIXELS=40000000
INFERENCE_MAX_IMAGE_SIDE=1280
# Model load (AUDIT H11): after this many seconds still loading, /health reports error.
INFERENCE_LOAD_TIMEOUT_S=1800
# Exit non-zero when the model fails to load. Only useful under a supervisor that restarts the process
# (systemd Restart=on-failure); without one the service stays up and /health reports the error.
INFERENCE_EXIT_ON_LOAD_ERROR=false
# Requests that may wait for the model while one runs; more get 503 queue_full (AUDIT R1).
INFERENCE_MAX_QUEUE=2
# Optional detector crop before the VLM (AUDIT P2): off (default) or crop. crop needs
# requirements-detector.txt (Ultralytics, AGPL-3.0) and a rerun of the parity check. The full frame was
# more accurate on the dataset, so turn it on only to try it on pilot frames.
INFERENCE_DETECTOR=off
# A local path avoids the download on first load (Ultralytics fetches yolo11s.pt otherwise).
INFERENCE_DETECTOR_WEIGHTS=yolo11s.pt
INFERENCE_DETECTOR_CONF=0.25
