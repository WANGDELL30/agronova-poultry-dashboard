# Behind a Cloudflare Tunnel on the same machine: API_HOST=127.0.0.1
API_HOST=0.0.0.0
API_PORT=4000
APP_VERSION=0.1.0
WEB_ORIGIN=http://localhost:3000
# Proxies whose X-Forwarded-For is trusted. cloudflared on the same machine: 127.0.0.1,::1
API_TRUST_PROXY=
# Optional: only the health check uses PostgreSQL today (results are in memory). Without it,
# /api/v1/health reports database "not_configured" and status "degraded"; nothing else changes.
# DATABASE_URL=postgresql://agronova:replace_with_a_local_password@localhost:5432/agronova
DATABASE_CONNECT_TIMEOUT_MS=3000
DEVICE_OFFLINE_AFTER_MS=30000

# Telemetry ingest (POST /api/v1/telemetry). Comma-separated device_id=key pairs; each key at least
# 16 characters, unique, sent by the device as the X-Device-Key header. Empty = anyone may post
# readings: only acceptable while the API is reachable from this machine alone. Never commit keys.
TELEMETRY_DEVICE_KEYS=

# Vision / inference service
# Inference on this machine (uvicorn, mock or real): http://localhost:8000
# Colab/Kaggle tunnel or a separate GPU server: its https URL, and set INFERENCE_API_KEY.
INFERENCE_URL=http://localhost:8000
INFERENCE_API_KEY=
# 60 s fits a T4 (PV9: (1 + INFERENCE_MAX_QUEUE 2) x p95 11.55 s x 1.5 = 52 s). Re-measure on another GPU.
INFERENCE_TIMEOUT_MS=60000
# Short, separate timeout for GET /api/v1/vision/health (default 5000).
INFERENCE_HEALTH_TIMEOUT_MS=5000
# VISION_IMAGE_DIR=./data/vision-images
# VISION_MAX_IMAGE_BYTES=8388608

# Vision upload protection (AUDIT S2). Comma-separated camera_id=key pairs; each key at least 16
# characters and unique, sent by the camera or gateway as X-Camera-Key. With keys set, keyless uploads
# (the dashboard's "try a photo") are manual: classified, rate limited, never voting or alerting.
# Empty = every upload counts as a camera frame (demos without a gateway). Never commit keys.
VISION_CAMERA_KEYS=
# VISION_MANUAL_UPLOADS_PER_IP_PER_HOUR=10
# VISION_MANUAL_UPLOADS_PER_HOUR=60
# VISION_CAMERA_INTERVAL_MS=10000
# VISION_MAX_CAMERA_RECORDS=2000
# VISION_MAX_MANUAL_RECORDS=200
