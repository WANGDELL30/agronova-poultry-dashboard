# --- Bot server ---
WA_BOT_HOST=0.0.0.0
WA_BOT_PORT=4100

# --- AgroNova API (read-only) ---
AGRONOVA_API_BASE_URL=http://localhost:4000
AGRONOVA_API_TIMEOUT_MS=5000
# Optional: only report this device. Empty = the newest device the API holds.
AGRONOVA_DEVICE_ID=

# --- WhatsApp provider: console (local, sends nothing) or meta (WhatsApp Cloud API) ---
WA_PROVIDER=console
# Required when WA_PROVIDER=meta. Never commit real values.
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=
# Use the Graph API version shown in your Meta app dashboard.
WA_GRAPH_API_VERSION=v23.0

# --- Who may talk to the bot (comma-separated, country code, digits only) ---
WA_ALLOWED_NUMBERS=
# Who receives warnings. Empty = WA_ALLOWED_NUMBERS.
WA_ALERT_RECIPIENTS=

# --- Warnings ---
WA_POLL_INTERVAL_MS=10000
WA_ALERT_COOLDOWN_MS=900000
# Approved utility template with exactly one body parameter, e.g. "Peringatan AgroNova: {{1}}".
# Needed to reach a number that has not messaged the bot in the last 24 hours.
WA_ALERT_TEMPLATE=
WA_ALERT_TEMPLATE_LANGUAGE=id
# Optional thresholds. Empty = disabled. The farm owner decides these values.
WA_TEMP_MAX_C=
WA_TEMP_MIN_C=
WA_HUMIDITY_MAX_PCT=
WA_HUMIDITY_MIN_PCT=

# --- Question answering: open-source model behind an OpenAI-compatible server (Ollama, vLLM) ---
# Empty base URL = no LLM; questions get the fixed status summary.
# Ollama on the same machine: http://localhost:11434/v1
WA_LLM_BASE_URL=
WA_LLM_MODEL=qwen3:4b
# Only for servers that require a key. Ollama does not.
WA_LLM_API_KEY=
WA_LLM_TIMEOUT_MS=60000
WA_RATE_LIMIT_PER_HOUR=30

# --- Display ---
WA_DISPLAY_TIMEZONE=Asia/Jakarta

# --- Device control: not implemented. Only "false" is accepted. ---
WA_CONTROL_ENABLED=false
