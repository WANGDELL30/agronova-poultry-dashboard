# Copy this file to .env for Docker Compose. Replace the example password locally.
POSTGRES_DB=agronova
POSTGRES_USER=agronova
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
MQTT_PORT=1883

# Inference service (only used with: docker compose --profile inference|gpu up ...)
INFERENCE_PORT=8000
# Shared secret between the API and the inference service. Leave empty for local-only use.
INFERENCE_API_KEY=
# Real mode only, optional: the default adapter repo is public. Set it only for a private adapter
# repo. Never commit a real token.
HF_TOKEN=
HF_ADAPTER_REPO=Arga23/chickenstress-vlm-lora
HF_BASE_MODEL=Qwen/Qwen3-VL-4B-Instruct
# Image limits applied by the inference service before the quality gate (AUDIT R2).
INFERENCE_MAX_IMAGE_PIXELS=40000000
INFERENCE_MAX_IMAGE_SIDE=1280
